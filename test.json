{
  "info": {
    "name": "RIP CAVI API - Lab3 (21 requests by domain)",
    "_postman_id": "21-req-collection-00000001",
    "description": "Коллекция из 21 запроса: Услуги(7), Заявки(7), M-M(2), Пользователь(5). Пути без cart/items.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET",
      "item": [
        {
          "name": "Заявки — GET черновик (id и кол-во услуг)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cavi-calculations/draft" },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('200 OK', () => pm.response.code === 200);",
            "pm.test('Has calculation_id number', () => typeof j.calculation_id === 'number');",
            "pm.test('Has groups count', () => typeof j.items === 'number' || typeof j.groups === 'number');"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Заявки — GET список (статус+даты формирования)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cavi-calculations?status=formed&date_from=2025-01-01&date_to=2025-12-31"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Заявки — GET одна заявка",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK or 404 if not created yet', () => [200,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Услуги — GET список (фильтр title)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cavi-groups?title=пациенты" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Услуги — GET одна запись",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cavi-groups/{{groupId1}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK or 404 if not created yet', () => [200,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Услуги — GET список (без фильтра)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cavi-groups" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Пользователь — GET профиль (после аутентификации)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/me" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK or 401/404 when not implemented', () => [200,401,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "POST",
      "item": [
        {
          "name": "Услуги — POST добавление услуги 1 (без изображения)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cavi-groups",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"ЛР3 Услуга 1\",\"age_group\":\"young\",\"description\":\"demo\",\"base_price\":100.5}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('201 Created', () => pm.response.code === 201);",
            "pm.environment.set('groupId1', _.get(j,'data.id'));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Услуги — POST добавление услуги 2 (без изображения)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cavi-groups",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"ЛР3 Услуга 2\",\"age_group\":\"middle\",\"description\":\"demo2\",\"base_price\":210.0}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.code === 201);",
            "pm.environment.set('groupId2', _.get(pm.response.json(),'data.id'));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Услуги — POST добавление изображения по id (замена старого)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cavi-groups/{{groupId1}}/image",
            "body": { "mode": "formdata", "formdata": [ { "key": "image", "type": "file", "src": "" } ] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);",
            "pm.test('Has image_url', () => _.get(pm.response.json(),'image_url'));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Услуги — POST добавление в заявку-черновик (group1)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/cavi-groups/{{groupId1}}/add-to-draft" },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('201 Created', () => pm.response.code === 201);",
            "pm.environment.set('calculationId', j.calculation_id);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Услуги — POST добавление в заявку-черновик (group2)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/cavi-groups/{{groupId2}}/add-to-draft" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.code === 201);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Пользователь — POST регистрация (moderator)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"moderator\",\"password\":\"demo123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201/200/404 acceptable', () => [201,200,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Пользователь — POST регистрация (user1)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"user1\",\"password\":\"demo123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201/200/404 acceptable', () => [201,200,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Пользователь — POST аутентификация (user1)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"user1\",\"password\":\"demo123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200/201/401/404 acceptable', () => [200,201,401,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Пользователь — POST аутентификация (moderator)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"moderator\",\"password\":\"demo123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200/201/401/404 acceptable', () => [200,201,401,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Пользователь — POST аутентификация (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"demo123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200/201/401/404 acceptable', () => [200,201,401,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Пользователь — POST деавторизация",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/users/logout" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200/204/401/404 acceptable', () => [200,204,401,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "PUT",
      "item": [
        {
          "name": "Услуги — PUT изменение услуги",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-groups/{{groupId1}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"description\":\"updated demo\",\"base_price\":150.75}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Заявки — PUT изменение полей заявки (по теме)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"systolic_pressure\":120,\"diastolic_pressure\":80,\"pulse_wave_velocity\":8.5}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200 OK', () => pm.response.code === 200);" ], "type": "text/javascript" } }]
        },
        {
          "name": "Заявки — PUT сформировать черновик создателем",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}/form" },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200 OK', () => pm.response.code === 200);" ], "type": "text/javascript" } }]
        },
        {
          "name": "Заявки — PUT завершить модератором (с расчётом)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}/moderate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"action\":\"complete\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const code = pm.response.code;",
            "pm.test('200 OK or 400 if not formed', () => [200,400].includes(code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Заявки — PUT отклонить модератором",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}/moderate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"action\":\"reject\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const code = pm.response.code;",
            "pm.test('200 OK or 400 if not formed or already completed', () => [200,400].includes(code));"
          ], "type": "text/javascript" } }]
        },
        
        {
          "name": "M-M — PUT изменение значений в м-м (цены)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/draft/groups",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"group_id\": 1, \"group_price\": 199.99}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200 OK', () => pm.response.code === 200);" ], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "DELETE",
      "item": [
        {
          "name": "Услуги — DELETE удаление записи (с удалением изображения)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cavi-groups/{{groupId2}}" },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200 OK', () => pm.response.code === 200);" ], "type": "text/javascript" } }]
        },
        {
          "name": "Заявки — DELETE удаление заявки (soft, только черновик)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK for draft, 400 otherwise', () => [200,400].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "M-M — DELETE удаление из заявки (без PK м-м)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/cavi-calculations/draft/groups",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"group_id\": 2}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200 OK', () => pm.response.code === 200);" ], "type": "text/javascript" } }]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ]
}