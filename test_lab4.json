	"item": [
		{
			"name": "1. Гость: GET заявки (401)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 401\", function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"pm.test(\"Response contains error message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"fail\");",
							"    pm.expect(jsonData.message).to.include(\"токен\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/api/cavi-calculations",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8000",
					"path": ["api", "cavi-calculations"]
				},
				"description": "Гость без токена не может получить список заявок"
			},
			"response": []
		},
		{
			"name": "2. Логин user1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains token\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"ok\");",
							"    pm.expect(jsonData.token).to.exist;",
							"    pm.environment.set(\"user_token\", jsonData.token);",
							"});",
							"",
							"pm.test(\"User is not moderator\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.user.is_moderator).to.eql(false);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"user1\",\n    \"password\": \"password\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/api/auth/login",
