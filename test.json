{
  "info": {
    "name": "RIP CAVI API - Lab4 (JWT + Redis)",
    "_postman_id": "lab4-jwt-collection-00000001",
    "description": "Коллекция из 22 запросов с JWT авторизацией: Users(6), Groups(7), Calculations(7), M-M(2). Порт 8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "1.1 Register user1",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"user1\",\"password\":\"password123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created or 400 exists', () => [201,400].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "1.2 Register doctor",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"doctor\",\"password\":\"password123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created or 400 exists', () => [201,400].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "1.3 Login user1",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"user1\",\"password\":\"password123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('200 OK', () => pm.response.code === 200);",
            "pm.test('Has token', () => !!j.token);",
            "pm.test('Has refresh_token', () => !!j.refresh_token);",
            "if (j.token) pm.environment.set('accessToken', j.token);",
            "if (j.refresh_token) pm.environment.set('refreshToken', j.refresh_token);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "1.4 Get current user (me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);",
            "pm.test('Has username', () => !!pm.response.json().username);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "1.5 Refresh tokens",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refresh_token\":\"{{refreshToken}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('200 OK', () => pm.response.code === 200);",
            "if (j.token) pm.environment.set('accessToken', j.token);",
            "if (j.refresh_token) pm.environment.set('refreshToken', j.refresh_token);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "1.6 Login doctor (for doctor tests)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"doctor\",\"password\":\"password123\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('200 OK', () => pm.response.code === 200);",
            "if (j.token) pm.environment.set('doctorToken', j.token);"
          ], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "2. Groups (Услуги)",
      "item": [
        {
          "name": "2.1 GET список групп (без авторизации)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cavi-groups" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);",
            "pm.test('Is array', () => Array.isArray(pm.response.json()));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "2.2 GET список с фильтром title",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cavi-groups?title=пациенты" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "2.3 GET одна группа",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cavi-groups/1" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 or 404', () => [200,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "2.4 POST создать группу (doctor)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cavi-groups",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Test Group\",\"age_group\":\"young\",\"description\":\"Test description\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('201 Created or 403 not doctor', () => [201,403].includes(pm.response.code));",
            "if (j.id) pm.environment.set('groupId1', j.id);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "2.5 PUT обновить группу (doctor)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-groups/{{groupId1}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"description\":\"Updated description\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK or 403', () => [200,403].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "2.6 POST добавить в черновик",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cavi-groups/{{groupId1}}/add-to-draft",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json();",
            "pm.test('201 Created', () => pm.response.code === 201);",
            "if (j.calculation_id) pm.environment.set('calculationId', j.calculation_id);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "2.7 DELETE удалить группу (doctor)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/cavi-groups/{{groupId1}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK or 403', () => [200,403].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "3. Calculations (Заявки)",
      "item": [
        {
          "name": "3.1 GET черновик (корзина)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cavi-calculations/draft",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);",
            "pm.test('Has calculation_id', () => typeof pm.response.json().calculation_id === 'number');"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "3.2 GET список заявок",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cavi-calculations?status=formed",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "3.3 GET одна заявка",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 or 404', () => [200,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "3.4 PUT обновить заявку",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"systolic_pressure\":120,\"diastolic_pressure\":80}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "3.5 PUT сформировать заявку",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/draft/form",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 or 400 no groups', () => [200,400,404].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "3.6 PUT модерация (complete)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}/moderate",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"action\":\"complete\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 or 400/403', () => [200,400,403].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "3.7 DELETE удалить заявку",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 or 400 not draft', () => [200,400].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "4. M-M (Группы в заявке)",
      "item": [
        {
          "name": "4.1 PUT обновить группу в черновике",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/draft/groups",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"group_id\":1,\"cavi_index\":7.5}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 or 400', () => [200,400].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "4.2 DELETE удалить группу из черновика",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/cavi-calculations/draft/groups",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"group_id\":1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 or 400', () => [200,400].includes(pm.response.code));"
          ], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "5. Async CAVI Service",
      "item": [
        {
          "name": "5.1 Health check (async service)",
          "request": {
            "method": "GET",
            "url": "{{asyncServiceUrl}}/api/health"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);",
            "pm.test('Service is cavi-async-calculator', () => pm.response.json().service === 'cavi-async-calculator');"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "5.2 Calculate CAVI (async)",
          "request": {
            "method": "POST",
            "url": "{{asyncServiceUrl}}/api/calculate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"calculation_id\": {{calculationId}},\n  \"systolic_pressure\": 120,\n  \"diastolic_pressure\": 80,\n  \"pulse_wave_velocity\": 8.5,\n  \"groups\": [\n    {\"group_id\": 1, \"age_group\": \"young\", \"disease_type\": null},\n    {\"group_id\": 2, \"age_group\": \"middle\", \"disease_type\": \"diabetes\"},\n    {\"group_id\": 3, \"age_group\": \"elderly\", \"disease_type\": \"hypertension\"}\n  ]\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('202 Accepted', () => pm.response.code === 202);",
            "pm.test('Status is accepted', () => pm.response.json().status === 'accepted');",
            "pm.test('Has groups_count', () => pm.response.json().groups_count === 3);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "5.3 Calculate CAVI - missing fields",
          "request": {
            "method": "POST",
            "url": "{{asyncServiceUrl}}/api/calculate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"calculation_id\": 1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.code === 400);",
            "pm.test('Has error message', () => pm.response.json().status === 'error');"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "5.4 Calculate CAVI - empty groups",
          "request": {
            "method": "POST",
            "url": "{{asyncServiceUrl}}/api/calculate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"calculation_id\": 1,\n  \"systolic_pressure\": 120,\n  \"diastolic_pressure\": 80,\n  \"pulse_wave_velocity\": 8.5,\n  \"groups\": []\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.code === 400);",
            "pm.test('No groups error', () => pm.response.json().message === 'No groups provided');"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "5.5 Trigger async via Go backend (doctor)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}/trigger-async",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK or 503 async unavailable', () => [200,503,403,404].includes(pm.response.code));",
            "if (pm.response.code === 200) pm.test('Status ok', () => pm.response.json().status === 'ok');"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "5.6 Update async result (with token)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}/async-result",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"cavi-async-secret-token-8bytes\",\n  \"results\": [\n    {\"group_id\": 1, \"cavi_index\": 7.234},\n    {\"group_id\": 2, \"cavi_index\": 8.567}\n  ]\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);",
            "pm.test('Results updated', () => pm.response.json().status === 'ok');"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "5.7 Update async result - invalid token",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/cavi-calculations/{{calculationId}}/async-result",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"wrong-token\",\n  \"results\": [{\"group_id\": 1, \"cavi_index\": 5.0}]\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.code === 401);",
            "pm.test('Invalid token message', () => pm.response.json().message === 'invalid token');"
          ], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "6. Logout",
      "item": [
        {
          "name": "5.1 Logout (blacklist token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/logout",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.code === 200);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "5.2 Try access after logout (should fail)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized (token blacklisted)', () => pm.response.code === 401);"
          ], "type": "text/javascript" } }]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "asyncServiceUrl", "value": "http://localhost:8001" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "doctorToken", "value": "" },
    { "key": "groupId1", "value": "1" },
    { "key": "calculationId", "value": "1" }
  ]
}
